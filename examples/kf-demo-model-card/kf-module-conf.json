  "capabilities": {
    "routes": [
      {
        "method": "GET",
        "path": "/m/kf-demo-model-card/cards",
        "right": "api.v1.m.kf-demo-model-card.cards.get",
        "audience": "member"
      },
      {
        "method": "GET",
        "path": "/m/kf-demo-model-card/models",
        "right": "api.v1.m.kf-demo-model-card.models.get",
        "audience": "member"
      },
      {
        "method": "GET",
        "path": "/m/kf-demo-model-card/models/{modelId}",
        "right": "api.v1.m.kf-demo-model-card.models.get",
        "audience": "member"
      },
      {
        "method": "PUT",
        "path": "/m/kf-demo-model-card/pins/{modelId}",
        "right": "api.v1.m.kf-demo-model-card.pins.put",
        "audience": "member"
      },
      {
        "method": "DELETE",
        "path": "/m/kf-demo-model-card/pins/{modelId}",
        "right": "api.v1.m.kf-demo-model-card.pins.delete",
        "audience": "member"
      },
      {
        "method": "DELETE",
        "path": "/m/kf-demo-model-card/admin/pins",
        "right": "api.v1.m.kf-demo-model-card.admin.pins.delete",
        "admin": "tenant"
      },
      {
        "method": "GET",
        "path": "/m/kf-demo-model-card/admin/export",
        "right": "api.v1.m.kf-demo-model-card.admin.export.get",
        "admin": "platform",
        "timeoutSeconds": 60
      },
      {
        "method": "POST",
        "path": "/m/kf-demo-model-card/admin/import",
        "right": "api.v1.m.kf-demo-model-card.admin.import.post",
        "admin": "platform",
        "timeoutSeconds": 60
      }
    ],
    "hooks": [
      {
        "point": "model.after.delete"
      },
      {
        "point": "tenant.after.delete"
      }
    ],
    "reads": [
      {
        "port": "model.v1"
      },
      {
        "port": "model-version.garment-image.v1"
      }
    ],
    "notifications": [
      {
        "key": "pinned-model-deleted",
        "variables": ["modelName"],
        "channels": ["in_app"],
        "subject": "notification.pinned-model-deleted.subject",
        "body": "notification.pinned-model-deleted.body"
      }
    ],
    "surfaces": [
      {
        "slug": "models.detail.overview.cards",
        "kind": "react",
        "label": "surface.card"
      },
      {
        "slug": "module.pages",
        "kind": "react",
        "label": "page.cards",
        "page": "cards"
      }
    ],
    "nav": [
      {
        "surface": "staff",
        "group": "product",
        "key": "cards",
        "label": "nav.cards",
        "url": "/m/kf-demo-model-card/cards",
        "icon": "LayoutGrid",
        "order": 50
      }
    ]
  }
}
