{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [],
    "paths": {
      "kf-module-sdk/surfaces": ["../.sdk/sdk/ts/kf-module-sdk/src/surfaces.generated.ts"],
      "react": ["./node_modules/@types/react"]
    }
  },
  "include": ["src", "../.sdk/sdk/ui/kf-host.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
