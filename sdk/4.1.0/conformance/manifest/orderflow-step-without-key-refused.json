{
  "id": "manifest/orderflow-step-without-key-refused",
  "area": "manifest",
  "description": "A contribution to orderflow.step without the key of its step is refused with the platform's text.",
  "source": "sdk-protocol.md §3.2, §16",
  "input": {
    "manifest": {
      "schemaVersion": 3,
      "slug": "kf-step",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Step",
          "step.label": "Item check"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/kf-step/rules/item-ready",
            "right": "api.v1.m.kf-step.rules.item-ready.get"
          },
          {
            "method": "POST",
            "path": "/m/kf-step/items",
            "right": "api.v1.m.kf-step.items.post"
          }
        ],
        "surfaces": [
          {
            "slug": "orderflow.step",
            "kind": "react"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.surfaces[0] on \"orderflow.step\" needs a \"key\": the key of the step it renders"
    ]
  }
}
