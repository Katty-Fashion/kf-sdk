{
  "id": "manifest/description-key-without-en-refused",
  "area": "manifest",
  "description": "A description key that i18n.en does not define is an error, as for name.",
  "source": "sdk-protocol.md §3.1",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "description": "module.description",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module"
        }
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "\"description\" \"module.description\" is not defined in i18n.en"
    ]
  }
}
