{
  "id": "manifest/flags-requires-modules-valid",
  "area": "manifest",
  "description": "A flag that requires a module declared (optionally) in requires, under schemaVersion 3: valid and read.",
  "source": "sdk-protocol.md §3.2, §3.5",
  "input": {
    "manifest": {
      "schemaVersion": 3,
      "slug": "req-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Requires",
          "flag.l": "Flag"
        }
      },
      "requires": [
        {
          "slug": "base-mod",
          "versionRange": ">=1.0.0 <2.0.0"
        },
        {
          "slug": "extra-mod",
          "versionRange": ">=0.5.0",
          "optional": true
        }
      ],
      "featureFlags": [
        {
          "key": "needs",
          "label": "flag.l",
          "requiresModules": [
            "extra-mod"
          ]
        }
      ]
    }
  },
  "expect": {
    "valid": true,
    "warningsContain": [],
    "read": {
      "/featureFlags/0/requiresModules/0": "extra-mod"
    }
  }
}
