{
  "id": "manifest/requires-bad-range-refused",
  "area": "manifest",
  "description": "A range outside the platform's grammar is refused, naming the expected form.",
  "source": "sdk-protocol.md §3.2, §3.5",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "req-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Requires",
          "flag.l": "Flag"
        }
      },
      "requires": [
        {
          "slug": "base-mod",
          "versionRange": "~1.2"
        }
      ]
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "\"requires\" entry for \"base-mod\": version range '~1.2' could not be parsed",
      "expected one of:"
    ]
  }
}
