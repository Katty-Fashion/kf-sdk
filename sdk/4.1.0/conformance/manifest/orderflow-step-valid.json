{
  "id": "manifest/orderflow-step-valid",
  "area": "manifest",
  "description": "A contribution to orderflow.step that names its step is accepted locally and read typed (the platform decides whether it delivers the surface).",
  "source": "sdk-protocol.md §3.2, §16",
  "input": {
    "manifest": {
      "schemaVersion": 3,
      "slug": "kf-step",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Step",
          "step.label": "Item check"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/kf-step/rules/item-ready",
            "right": "api.v1.m.kf-step.rules.item-ready.get"
          },
          {
            "method": "POST",
            "path": "/m/kf-step/items",
            "right": "api.v1.m.kf-step.items.post"
          }
        ],
        "surfaces": [
          {
            "slug": "orderflow.step",
            "kind": "react",
            "key": "item-check",
            "label": "step.label"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": true,
    "read": {
      "/capabilities/surfaces/0/slug": "orderflow.step",
      "/capabilities/surfaces/0/key": "item-check"
    }
  }
}
