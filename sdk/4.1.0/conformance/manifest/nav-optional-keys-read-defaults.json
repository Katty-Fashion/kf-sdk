{
  "id": "manifest/nav-optional-keys-read-defaults",
  "area": "manifest",
  "description": "A platform menu entry with only the required keys is valid; icon, right and flag read null, order reads 100 (the default).",
  "source": "sdk-protocol.md §3.2, §7.11",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "nav.events": "Events"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/man-mod/events",
            "right": "api.v1.m.man-mod.events.get"
          }
        ],
        "nav": [
          {
            "surface": "platform",
            "group": "platform-main",
            "key": "events",
            "label": "nav.events",
            "url": "/setup/events"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": true,
    "read": {
      "/capabilities/nav/0/icon": null,
      "/capabilities/nav/0/right": null,
      "/capabilities/nav/0/flag": null,
      "/capabilities/nav/0/order": 100
    }
  }
}
