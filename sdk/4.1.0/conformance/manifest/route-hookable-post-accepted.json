{
  "id": "manifest/route-hookable-post-accepted",
  "area": "manifest",
  "description": "hookable: true on a POST route is accepted and read as true.",
  "source": "a rule of the SDK itself",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "field.priority": "Priority",
          "tab.label": "Tab"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "POST",
            "path": "/m/man-mod/notes",
            "right": "api.v1.m.man-mod.notes.post",
            "hookable": true
          },
          {
            "method": "PATCH",
            "path": "/m/man-mod/notes/{id}",
            "right": "api.v1.m.man-mod.notes.patch",
            "hookable": true
          }
        ]
      }
    }
  },
  "expect": {
    "valid": true,
    "read": {
      "/capabilities/routes/0/hookable": true,
      "/capabilities/routes/1/hookable": true
    }
  }
}
