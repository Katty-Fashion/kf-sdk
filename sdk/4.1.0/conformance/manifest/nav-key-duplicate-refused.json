{
  "id": "manifest/nav-key-duplicate-refused",
  "area": "manifest",
  "description": "The same nav key twice on one surface is refused (the public key m.{slug}.{key} must be unique in a menu).",
  "source": "sdk-protocol.md §3.2, §7.11",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "nav.events": "Events"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/man-mod/events",
            "right": "api.v1.m.man-mod.events.get"
          }
        ],
        "nav": [
          {
            "surface": "staff",
            "group": "admin-utils",
            "key": "events",
            "label": "nav.events",
            "url": "/modules"
          },
          {
            "surface": "staff",
            "group": "admin-utils",
            "key": "events",
            "label": "nav.events",
            "url": "/modules"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.nav[1].key \"events\" is declared twice on the surface staff"
    ]
  }
}
