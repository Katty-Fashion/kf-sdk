{
  "id": "manifest/secrets-external-valid",
  "area": "manifest",
  "description": "A platform secret may declare external prefixes: the module may keep an existing vault reference under them instead of a value it writes. Accepted and read; a secret without the key reads [].",
  "source": "sdk-protocol.md §3.2, §15.3",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "setting.push": "Push on save",
          "setting.timeout": "Timeout",
          "setting.mode": "Mode",
          "setting.mode.help": "How the module pushes",
          "tab.label": "AAS"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/man-mod/stations",
            "right": "api.v1.m.man-mod.stations.get"
          },
          {
            "method": "GET",
            "path": "/m/man-mod/admin/config",
            "right": "api.v1.m.man-mod.admin.config.get",
            "admin": "tenant"
          },
          {
            "method": "PUT",
            "path": "/m/man-mod/admin/keys",
            "right": "api.v1.m.man-mod.admin.keys.put",
            "admin": "platform"
          },
          {
            "method": "PUT",
            "path": "/m/man-mod/admin/tenant-keys",
            "right": "api.v1.m.man-mod.admin.tenant-keys.put",
            "admin": "tenant"
          }
        ],
        "secrets": [
          {
            "name": "r3-client-secret",
            "scope": "platform",
            "writeRight": "api.v1.m.man-mod.admin.keys.put",
            "external": [
              "platform/aas/",
              "kv/r3-clients/"
            ]
          },
          {
            "name": "tenant-token",
            "scope": "tenant",
            "writeRight": "api.v1.m.man-mod.admin.tenant-keys.put"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": true,
    "warningsContain": [],
    "read": {
      "/capabilities/secrets/0/name": "r3-client-secret",
      "/capabilities/secrets/0/external/0": "platform/aas/",
      "/capabilities/secrets/0/external/1": "kv/r3-clients/",
      "/capabilities/secrets/1/external": []
    }
  }
}
