{
  "id": "manifest/route-role-tenant-admin-refused",
  "area": "manifest",
  "description": "TENANT_ADMIN (compared without case) on a module route is refused locally, naming the route and the role.",
  "source": "the platform ModuleManifestValidator",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "field.priority": "Priority",
          "tab.label": "Tab"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/man-mod/events",
            "right": "api.v1.m.man-mod.events.get",
            "roles": [
              "QC",
              "tenant_admin"
            ]
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "GET /m/man-mod/events",
      "\"tenant_admin\" cannot be declared"
    ]
  }
}
