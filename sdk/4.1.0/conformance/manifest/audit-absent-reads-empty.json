{
  "id": "manifest/audit-absent-reads-empty",
  "area": "manifest",
  "description": "A manifest without audit reads capabilities.audit as [].",
  "source": "a rule of the SDK itself",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "field.priority": "Priority",
          "tab.label": "Tab"
        }
      },
      "capabilities": {
        "fields": []
      }
    }
  },
  "expect": {
    "valid": true,
    "read": {
      "/capabilities/audit": []
    }
  }
}
