{
  "id": "manifest/audit-duplicate-access-refused",
  "area": "manifest",
  "description": "The same audit access declared twice is refused.",
  "source": "a rule of the SDK itself",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "field.priority": "Priority",
          "tab.label": "Tab"
        }
      },
      "capabilities": {
        "audit": [
          {
            "access": "write"
          },
          {
            "access": "write"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.audit[1].access \"write\" is declared twice"
    ]
  }
}
