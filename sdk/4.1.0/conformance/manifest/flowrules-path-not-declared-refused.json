{
  "id": "manifest/flowrules-path-not-declared-refused",
  "area": "manifest",
  "description": "A flow rule whose path is not a declared GET route is refused (a POST route does not count).",
  "source": "sdk-protocol.md §3.2, §16",
  "input": {
    "manifest": {
      "schemaVersion": 3,
      "slug": "kf-step",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Step",
          "step.label": "Item check"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/kf-step/rules/item-ready",
            "right": "api.v1.m.kf-step.rules.item-ready.get"
          },
          {
            "method": "POST",
            "path": "/m/kf-step/items",
            "right": "api.v1.m.kf-step.items.post"
          }
        ],
        "flowRules": [
          {
            "key": "item-ready",
            "path": "/m/kf-step/items",
            "projection": "order.flow-rule.v1"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.flowRules[0].path \"/m/kf-step/items\" is not a GET route this module declares"
    ]
  }
}
