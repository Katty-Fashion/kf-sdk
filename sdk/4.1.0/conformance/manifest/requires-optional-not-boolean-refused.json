{
  "id": "manifest/requires-optional-not-boolean-refused",
  "area": "manifest",
  "description": "Under schemaVersion 3, requires[].optional must be a boolean.",
  "source": "sdk-protocol.md §3.2, §3.5",
  "input": {
    "manifest": {
      "schemaVersion": 3,
      "slug": "req-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Requires",
          "flag.l": "Flag"
        }
      },
      "requires": [
        {
          "slug": "base-mod",
          "versionRange": ">=1.0.0",
          "optional": "yes"
        }
      ]
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "\"requires[0].optional\" must be a boolean (got \"yes\")"
    ]
  }
}
