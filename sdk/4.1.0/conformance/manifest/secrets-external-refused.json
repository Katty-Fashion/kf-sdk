{
  "id": "manifest/secrets-external-refused",
  "area": "manifest",
  "description": "external is refused on a tenant secret, as an empty array, with a prefix outside the grammar (one segment, no trailing /, a dot), into the modules' path (kf-modules), or twice.",
  "source": "sdk-protocol.md §3.2, §15.3",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "setting.push": "Push on save",
          "setting.timeout": "Timeout",
          "setting.mode": "Mode",
          "setting.mode.help": "How the module pushes",
          "tab.label": "AAS"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/man-mod/stations",
            "right": "api.v1.m.man-mod.stations.get"
          },
          {
            "method": "GET",
            "path": "/m/man-mod/admin/config",
            "right": "api.v1.m.man-mod.admin.config.get",
            "admin": "tenant"
          },
          {
            "method": "PUT",
            "path": "/m/man-mod/admin/keys",
            "right": "api.v1.m.man-mod.admin.keys.put",
            "admin": "platform"
          },
          {
            "method": "PUT",
            "path": "/m/man-mod/admin/tenant-keys",
            "right": "api.v1.m.man-mod.admin.tenant-keys.put",
            "admin": "tenant"
          }
        ],
        "secrets": [
          {
            "name": "r3-client-secret",
            "scope": "platform",
            "writeRight": "api.v1.m.man-mod.admin.keys.put",
            "external": [
              "platform/",
              "platform/aas",
              "platform/../idp/",
              "platform/kf-modules/x/",
              "platform/aas/",
              "platform/aas/"
            ]
          },
          {
            "name": "tenant-token",
            "scope": "tenant",
            "writeRight": "api.v1.m.man-mod.admin.tenant-keys.put",
            "external": [
              "platform/aas/"
            ]
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.secrets[0].external must be a non-empty array of at most 5 prefixes",
      "capabilities.secrets[0].external[0] must match ^[a-z0-9][a-z0-9_-]{0,63}(/[a-z0-9][a-z0-9_-]{0,63})+/$ (got \"platform/\")",
      "capabilities.secrets[0].external[1] must match",
      "capabilities.secrets[0].external[2] must match",
      "capabilities.secrets[0].external[3] \"platform/kf-modules/x/\" must not reach the modules' secrets (kf-modules)",
      "capabilities.secrets[0].external[5] \"platform/aas/\" is declared twice",
      "capabilities.secrets[1].external is allowed only on a platform secret"
    ]
  }
}
