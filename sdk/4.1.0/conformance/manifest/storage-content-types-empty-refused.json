{
  "id": "manifest/storage-content-types-empty-refused",
  "area": "manifest",
  "description": "An empty contentTypes list is refused.",
  "source": "sdk-protocol.md §3.2, §15.7",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "widget.label": "Feedback"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "POST",
            "path": "/m/man-mod/tickets",
            "right": "api.v1.m.man-mod.tickets.post"
          }
        ],
        "storage": [
          {
            "contentTypes": [],
            "maxBytes": 100
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.storage[0].contentTypes must be 1 to 10 distinct type/subtype values, without wildcards"
    ]
  }
}
