{
  "id": "manifest/surface-page-twice-refused",
  "area": "manifest",
  "description": "One module declares each page of a surface once.",
  "source": "sdk-protocol.md §3.2, §15.6",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "tab.label": "AAS"
        }
      },
      "capabilities": {
        "surfaces": [
          {
            "slug": "module.pages",
            "kind": "react",
            "page": "shells"
          },
          {
            "slug": "module.pages",
            "kind": "wc",
            "page": "shells"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.surfaces[1].page \"shells\" is declared twice on \"module.pages\""
    ]
  }
}
