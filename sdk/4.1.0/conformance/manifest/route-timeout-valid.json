{
  "id": "manifest/route-timeout-valid",
  "area": "manifest",
  "description": "routes[].timeoutSeconds, a whole number of seconds between 1 and 60, is valid and read; absent or null reads null (the platform default, 5 s).",
  "source": "sdk-protocol.md §3.2, §9.1",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "setting.push": "Push on save",
          "setting.timeout": "Timeout",
          "setting.mode": "Mode",
          "setting.mode.help": "How the module pushes",
          "tab.label": "AAS"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/man-mod/stations",
            "right": "api.v1.m.man-mod.stations.get"
          },
          {
            "method": "GET",
            "path": "/m/man-mod/shells",
            "right": "api.v1.m.man-mod.shells.get",
            "admin": "tenant",
            "timeoutSeconds": 60
          },
          {
            "method": "POST",
            "path": "/m/man-mod/push",
            "right": "api.v1.m.man-mod.push.post",
            "timeoutSeconds": 1
          },
          {
            "method": "POST",
            "path": "/m/man-mod/sync",
            "right": "api.v1.m.man-mod.sync.post",
            "timeoutSeconds": null
          }
        ]
      }
    }
  },
  "expect": {
    "valid": true,
    "warningsContain": [],
    "read": {
      "/capabilities/routes/0/timeoutSeconds": null,
      "/capabilities/routes/1/timeoutSeconds": 60,
      "/capabilities/routes/2/timeoutSeconds": 1,
      "/capabilities/routes/3/timeoutSeconds": null
    }
  }
}
