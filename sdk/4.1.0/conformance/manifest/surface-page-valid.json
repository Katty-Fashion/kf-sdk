{
  "id": "manifest/surface-page-valid",
  "area": "manifest",
  "description": "surfaces[].page with the page grammar is valid and read; absent reads null.",
  "source": "sdk-protocol.md §3.2, §15",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "setting.push": "Push on save",
          "setting.timeout": "Timeout",
          "setting.mode": "Mode",
          "setting.mode.help": "How the module pushes",
          "tab.label": "AAS"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/man-mod/stations",
            "right": "api.v1.m.man-mod.stations.get"
          },
          {
            "method": "GET",
            "path": "/m/man-mod/admin/config",
            "right": "api.v1.m.man-mod.admin.config.get",
            "admin": "tenant"
          },
          {
            "method": "PUT",
            "path": "/m/man-mod/admin/keys",
            "right": "api.v1.m.man-mod.admin.keys.put",
            "admin": "platform"
          },
          {
            "method": "PUT",
            "path": "/m/man-mod/admin/tenant-keys",
            "right": "api.v1.m.man-mod.admin.tenant-keys.put",
            "admin": "tenant"
          }
        ],
        "surfaces": [
          {
            "slug": "module.page",
            "kind": "react",
            "label": "tab.label",
            "page": "shells"
          },
          {
            "slug": "models.detail.tabs",
            "kind": "react",
            "label": "tab.label"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": true,
    "warningsContain": [],
    "read": {
      "/capabilities/surfaces/0/page": "shells",
      "/capabilities/surfaces/1/page": null
    }
  }
}
