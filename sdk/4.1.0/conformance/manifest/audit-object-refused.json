{
  "id": "manifest/audit-object-refused",
  "area": "manifest",
  "description": "capabilities.audit as an object instead of a list is refused, naming the capability.",
  "source": "a rule of the SDK itself",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "field.priority": "Priority",
          "tab.label": "Tab"
        }
      },
      "capabilities": {
        "audit": {
          "access": "write"
        }
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.audit must be an array"
    ]
  }
}
