{
  "id": "manifest/settings-key-duplicate-refused",
  "area": "manifest",
  "description": "A setting key declared twice is refused.",
  "source": "sdk-protocol.md §3.2, §15",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "setting.push": "Push on save",
          "setting.timeout": "Timeout",
          "setting.mode": "Mode",
          "setting.mode.help": "How the module pushes",
          "tab.label": "AAS"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/man-mod/stations",
            "right": "api.v1.m.man-mod.stations.get"
          },
          {
            "method": "GET",
            "path": "/m/man-mod/admin/config",
            "right": "api.v1.m.man-mod.admin.config.get",
            "admin": "tenant"
          },
          {
            "method": "PUT",
            "path": "/m/man-mod/admin/keys",
            "right": "api.v1.m.man-mod.admin.keys.put",
            "admin": "platform"
          },
          {
            "method": "PUT",
            "path": "/m/man-mod/admin/tenant-keys",
            "right": "api.v1.m.man-mod.admin.tenant-keys.put",
            "admin": "tenant"
          }
        ],
        "settings": [
          {
            "key": "push",
            "type": "BOOLEAN",
            "default": true,
            "label": "setting.push"
          },
          {
            "key": "push",
            "type": "BOOLEAN",
            "default": false,
            "label": "setting.push"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.settings[1].key \"push\" is declared twice"
    ]
  }
}
