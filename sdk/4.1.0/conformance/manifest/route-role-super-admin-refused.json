{
  "id": "manifest/route-role-super-admin-refused",
  "area": "manifest",
  "description": "SUPER_ADMIN on a module route is refused locally.",
  "source": "the platform ModuleManifestValidator",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "field.priority": "Priority",
          "tab.label": "Tab"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "POST",
            "path": "/m/man-mod/notes",
            "right": "api.v1.m.man-mod.notes.post",
            "roles": [
              "SUPER_ADMIN"
            ]
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "\"SUPER_ADMIN\" cannot be declared"
    ]
  }
}
