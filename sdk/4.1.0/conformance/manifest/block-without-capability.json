{
  "id": "manifest/block-without-capability",
  "area": "manifest",
  "description": "onFailure block at registration needs block declared on the same point in the manifest; allow there refuses it locally.",
  "source": "the platform ManifestCapabilityGuard",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "field.priority": "Priority",
          "tab.label": "Tab"
        }
      },
      "capabilities": {
        "hooks": [
          {
            "point": "model.before.update",
            "onFailure": "allow"
          }
        ]
      }
    },
    "registration": {
      "slug": "man-mod",
      "callbackBase": "http://api.man-mod.kfmod:8080",
      "hooks": [
        {
          "event": "model.before.update",
          "onFailure": "block"
        }
      ]
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "onFailure \"block\" on model.before.update requires the capability"
    ]
  }
}
