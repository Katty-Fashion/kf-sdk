{
  "id": "manifest/flowrules-unknown-projection-refused",
  "area": "manifest",
  "description": "A flow rule that asks for a projection other than order.flow-rule.v1 is refused.",
  "source": "sdk-protocol.md §3.2, §16",
  "input": {
    "manifest": {
      "schemaVersion": 3,
      "slug": "kf-step",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Step",
          "step.label": "Item check"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/kf-step/rules/item-ready",
            "right": "api.v1.m.kf-step.rules.item-ready.get"
          },
          {
            "method": "POST",
            "path": "/m/kf-step/items",
            "right": "api.v1.m.kf-step.items.post"
          }
        ],
        "flowRules": [
          {
            "key": "item-ready",
            "path": "/m/kf-step/rules/item-ready",
            "projection": "order.flow-rule.v2"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.flowRules[0].projection \"order.flow-rule.v2\" must be \"order.flow-rule.v1\""
    ]
  }
}
