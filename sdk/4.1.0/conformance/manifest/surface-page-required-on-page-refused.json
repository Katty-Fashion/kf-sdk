{
  "id": "manifest/surface-page-required-on-page-refused",
  "area": "manifest",
  "description": "A surface of type page without a page is refused: the host opens it at /m/{slug}/{page}.",
  "source": "sdk-protocol.md §3.2, §15.6",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "tab.label": "AAS"
        }
      },
      "capabilities": {
        "surfaces": [
          {
            "slug": "module.pages",
            "kind": "react",
            "label": "tab.label"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.surfaces[0].page is required on a surface of type page (\"module.pages\"): the host opens it at /m/man-mod/<page>"
    ]
  }
}
