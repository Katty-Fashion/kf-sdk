{
  "id": "manifest/requires-optional-under-schema2-refused",
  "area": "manifest",
  "description": "requires[].optional belongs to schemaVersion 3.",
  "source": "sdk-protocol.md §3.2, §3.5",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "req-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Requires",
          "flag.l": "Flag"
        }
      },
      "requires": [
        {
          "slug": "extra-mod",
          "versionRange": ">=0.5.0",
          "optional": true
        }
      ]
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "\"requires[0].optional\" requires \"schemaVersion\": 3"
    ]
  }
}
