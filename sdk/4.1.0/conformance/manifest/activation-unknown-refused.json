{
  "id": "manifest/activation-unknown-refused",
  "area": "manifest",
  "description": "An activation other than \"tenant\" or \"platform\" is refused, naming the value.",
  "source": "sdk-protocol.md §3.1",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "activation": "global",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "widget.label": "Feedback"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "POST",
            "path": "/m/man-mod/tickets",
            "right": "api.v1.m.man-mod.tickets.post"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "kf-module-conf.json: activation must be \"tenant\" or \"platform\" (got \"global\")"
    ]
  }
}
