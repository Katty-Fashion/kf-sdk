{
  "id": "manifest/nav-right-undeclared-refused",
  "area": "manifest",
  "description": "A right under api.v1.m. that is not the right of one of the module's own routes is refused locally (a platform code is the platform's check at upload).",
  "source": "sdk-protocol.md §3.2, §7.11",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "nav.events": "Events"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/man-mod/events",
            "right": "api.v1.m.man-mod.events.get"
          }
        ],
        "nav": [
          {
            "surface": "staff",
            "group": "admin-utils",
            "key": "events",
            "label": "nav.events",
            "url": "/modules",
            "right": "api.v1.m.man-mod.secret.get"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.nav[0].right \"api.v1.m.man-mod.secret.get\" is not the right of a route this module declares"
    ]
  }
}
