{
  "id": "manifest/route-admin-unknown-refused",
  "area": "manifest",
  "description": "An admin value other than tenant or platform is refused.",
  "source": "sdk-protocol.md §3.2, §15",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "setting.push": "Push on save",
          "setting.timeout": "Timeout",
          "setting.mode": "Mode",
          "setting.mode.help": "How the module pushes",
          "tab.label": "AAS"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/man-mod/admin/x",
            "right": "api.v1.m.man-mod.admin.x.get",
            "admin": "super"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      ".admin must be one of tenant, platform"
    ]
  }
}
