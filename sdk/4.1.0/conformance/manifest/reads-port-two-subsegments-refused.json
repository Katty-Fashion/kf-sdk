{
  "id": "manifest/reads-port-two-subsegments-refused",
  "area": "manifest",
  "description": "A port id with two sub-segments is refused (the grammar takes one).",
  "source": "sdk-protocol.md §3.2, §15",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "setting.push": "Push on save",
          "setting.timeout": "Timeout",
          "setting.mode": "Mode",
          "setting.mode.help": "How the module pushes",
          "tab.label": "AAS"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/man-mod/stations",
            "right": "api.v1.m.man-mod.stations.get"
          },
          {
            "method": "GET",
            "path": "/m/man-mod/admin/config",
            "right": "api.v1.m.man-mod.admin.config.get",
            "admin": "tenant"
          },
          {
            "method": "PUT",
            "path": "/m/man-mod/admin/keys",
            "right": "api.v1.m.man-mod.admin.keys.put",
            "admin": "platform"
          },
          {
            "method": "PUT",
            "path": "/m/man-mod/admin/tenant-keys",
            "right": "api.v1.m.man-mod.admin.tenant-keys.put",
            "admin": "tenant"
          }
        ],
        "reads": [
          {
            "port": "a.b.c.v1"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.reads[0].port \"a.b.c.v1\" must match"
    ]
  }
}
