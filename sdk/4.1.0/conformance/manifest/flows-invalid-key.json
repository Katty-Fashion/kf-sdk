{
  "id": "manifest/flows-invalid-key",
  "area": "manifest",
  "description": "A module flow key outside ^[a-z][a-z0-9-]{2,62}$ (upper case, too short) is refused, named.",
  "source": "sdk-protocol.md §3.2, §17",
  "input": {
    "manifest": {
      "schemaVersion": 3,
      "slug": "kf-3d",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "3D",
          "flow.twin": "Digital twin sample",
          "flow.fit": "Fit session"
        }
      },
      "capabilities": {
        "flows": [
          {
            "key": "Twin",
            "file": "flows/twin.bpmn",
            "name": "flow.twin"
          },
          {
            "key": "ab",
            "file": "flows/ab.bpmn",
            "name": "flow.fit"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.flows[0].key \"Twin\" must match ^[a-z][a-z0-9-]{2,62}$",
      "capabilities.flows[1].key \"ab\" must match ^[a-z][a-z0-9-]{2,62}$"
    ]
  }
}
