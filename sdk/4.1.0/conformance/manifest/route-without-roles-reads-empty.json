{
  "id": "manifest/route-without-roles-reads-empty",
  "area": "manifest",
  "description": "A route without roles reads as [] (no role).",
  "source": "the platform ModuleCapabilities.RouteCapability",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "field.priority": "Priority",
          "tab.label": "Tab"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/man-mod/events",
            "right": "api.v1.m.man-mod.events.get"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": true,
    "read": {
      "/capabilities/routes/0/roles": []
    }
  }
}
