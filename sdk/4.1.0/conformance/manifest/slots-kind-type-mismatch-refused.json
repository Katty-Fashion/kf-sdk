{
  "id": "manifest/slots-kind-type-mismatch-refused",
  "area": "manifest",
  "description": "A type that is not one of the slot kind's types (tab on kind B) is refused.",
  "source": "sdk-protocol.md §1, §1.A, §3.2, §7.12",
  "input": {
    "manifest": {
      "schemaVersion": 3,
      "slug": "slot-owner",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Slot owner",
          "slot.layers": "Viewport layers"
        }
      },
      "capabilities": {
        "slots": [
          {
            "key": "viewport.layers.v1",
            "kind": "B",
            "type": "tab",
            "visibility": "public",
            "label": "slot.layers",
            "layerKinds": [
              "pin",
              "highlight"
            ]
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.slots[0].type must be one of [layer] on kind B"
    ]
  }
}
