{
  "id": "manifest/audit-unknown-access-refused",
  "area": "manifest",
  "description": "An audit access other than write / read-own is refused.",
  "source": "a rule of the SDK itself",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "field.priority": "Priority",
          "tab.label": "Tab"
        }
      },
      "capabilities": {
        "audit": [
          {
            "access": "read-all"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.audit[0].access must be one of write, read-own"
    ]
  }
}
