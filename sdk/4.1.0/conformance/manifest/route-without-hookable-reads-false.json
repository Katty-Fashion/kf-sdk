{
  "id": "manifest/route-without-hookable-reads-false",
  "area": "manifest",
  "description": "A route without hookable reads as hookable = false (absent = false).",
  "source": "a rule of the SDK itself",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "field.priority": "Priority",
          "tab.label": "Tab"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "POST",
            "path": "/m/man-mod/notes",
            "right": "api.v1.m.man-mod.notes.post"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": true,
    "read": {
      "/capabilities/routes/0/hookable": false
    }
  }
}
