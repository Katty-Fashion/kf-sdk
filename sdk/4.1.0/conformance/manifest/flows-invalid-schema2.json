{
  "id": "manifest/flows-invalid-schema2",
  "area": "manifest",
  "description": "capabilities.flows under schemaVersion 2 is refused, named.",
  "source": "sdk-protocol.md §3.2, §17",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "kf-3d",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "3D",
          "flow.twin": "Digital twin sample",
          "flow.fit": "Fit session"
        }
      },
      "capabilities": {
        "flows": [
          {
            "key": "kf-3d-digital-twin",
            "file": "flows/kf-3d-digital-twin.bpmn",
            "name": "flow.twin"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.flows requires \"schemaVersion\": 3 (this manifest is schemaVersion 2)"
    ]
  }
}
