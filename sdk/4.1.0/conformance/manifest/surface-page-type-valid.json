{
  "id": "manifest/surface-page-type-valid",
  "area": "manifest",
  "description": "On the surfaces of type page of the pinned release list a page is declared once per surface; a surface of another type has none; a slug the list does not know is not judged locally.",
  "source": "sdk-protocol.md §3.2, §15.6",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "tab.label": "AAS"
        }
      },
      "capabilities": {
        "surfaces": [
          {
            "slug": "module.pages",
            "kind": "react",
            "label": "tab.label",
            "page": "shells"
          },
          {
            "slug": "module.pages",
            "kind": "react",
            "page": "stations"
          },
          {
            "slug": "setup.sections",
            "kind": "react",
            "page": "shells"
          },
          {
            "slug": "tenant-management.cards",
            "kind": "react",
            "label": "tab.label"
          },
          {
            "slug": "future.surface",
            "kind": "wc",
            "page": "anything"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": true,
    "warningsContain": [],
    "read": {
      "/capabilities/surfaces/0/page": "shells",
      "/capabilities/surfaces/2/page": "shells",
      "/capabilities/surfaces/3/page": null
    }
  }
}
