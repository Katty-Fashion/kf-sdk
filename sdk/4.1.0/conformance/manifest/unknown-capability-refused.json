{
  "id": "manifest/unknown-capability-refused",
  "area": "manifest",
  "description": "A capability key the SDK does not know is an error, never ignored; a DDL key names its rule.",
  "source": "the platform ModuleManifestValidator",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "field.priority": "Priority",
          "tab.label": "Tab"
        }
      },
      "capabilities": {
        "payments": [],
        "migrations": []
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "capabilities.payments is not a capability this SDK knows",
      "capabilities.migrations is not allowed: a module cannot run DDL"
    ]
  }
}
