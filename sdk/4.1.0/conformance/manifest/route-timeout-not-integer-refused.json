{
  "id": "manifest/route-timeout-not-integer-refused",
  "area": "manifest",
  "description": "A timeoutSeconds that is zero, fractional or a string is refused.",
  "source": "sdk-protocol.md §3.2, §9.1",
  "input": {
    "manifest": {
      "schemaVersion": 2,
      "slug": "man-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Manifest module",
          "setting.push": "Push on save",
          "setting.timeout": "Timeout",
          "setting.mode": "Mode",
          "setting.mode.help": "How the module pushes",
          "tab.label": "AAS"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/man-mod/a",
            "right": "api.v1.m.man-mod.a.get",
            "timeoutSeconds": 0
          },
          {
            "method": "GET",
            "path": "/m/man-mod/b",
            "right": "api.v1.m.man-mod.b.get",
            "timeoutSeconds": 1.5
          },
          {
            "method": "GET",
            "path": "/m/man-mod/c",
            "right": "api.v1.m.man-mod.c.get",
            "timeoutSeconds": "15"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "(GET /m/man-mod/a).timeoutSeconds must be a whole number of seconds between 1 and 60 (got 0)",
      "(GET /m/man-mod/b).timeoutSeconds must be a whole number of seconds between 1 and 60",
      "(GET /m/man-mod/c).timeoutSeconds must be a whole number of seconds between 1 and 60"
    ]
  }
}
