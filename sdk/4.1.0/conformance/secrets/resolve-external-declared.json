{
  "id": "secrets/resolve-external-declared",
  "area": "secrets",
  "description": "An existing reference under a prefix the manifest declares in secrets[].external is sent to the platform, which resolves it (and audits it): the value comes back.",
  "source": "sdk-protocol.md §15.3",
  "input": {
    "slug": "sec-mod",
    "context": {
      "v": 1,
      "tenant": "00000000-0000-0000-0000-00000000000a",
      "user": "subject-1",
      "actor": {
        "type": "user",
        "via": null,
        "hookId": null
      },
      "locale": "en",
      "rights": [],
      "method": "GET",
      "path": "/x",
      "query": null,
      "ts": "$now",
      "requestId": "req-sec-10"
    },
    "proof": "3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f",
    "manifest": {
      "schemaVersion": 2,
      "slug": "sec-mod",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "Secrets module"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "PUT",
            "path": "/m/sec-mod/admin/r3",
            "right": "api.v1.m.sec-mod.admin-r3.put",
            "admin": "platform"
          }
        ],
        "secrets": [
          {
            "name": "r3-client-secret",
            "scope": "platform",
            "writeRight": "api.v1.m.sec-mod.admin-r3.put",
            "external": [
              "platform/aas/"
            ]
          }
        ]
      }
    },
    "call": "resolve",
    "args": {
      "ref": "vault://platform/aas/kf-r3/client-secret"
    },
    "platform": {
      "status": 200,
      "body": "{\"value\":\"r3-Pa55-never-logged\"}"
    }
  },
  "expect": {
    "outcome": "ok",
    "request": {
      "method": "POST",
      "path": "/api/v1/platform/modules/sec-mod/secrets/resolve",
      "query": null,
      "headers": {
        "Authorization": "Bearer kfm_conformance-token-never-logged",
        "X-KF-Context": "$context",
        "X-KF-Context-Proof": "3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f"
      },
      "body": {
        "ref": "vault://platform/aas/kf-r3/client-secret"
      }
    },
    "result": "r3-Pa55-never-logged"
  }
}
