<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>ro.kf</groupId>
    <artifactId>kf-module-sdk</artifactId>
    <version>4.1.0</version>
    <packaging>jar</packaging>
    <name>kf-module-sdk</name>
    <description>
        KF platform module SDK (Java): registers hooks, extension fields and UI contributions at boot and serves the
        signed platform callbacks (POST /_kf/hooks). Works without Spring; ro.kf.sdk.spring is an optional adapter.
    </description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- same versions as Spring Boot 4.0.6 (the platform and the Boot test modules) -->
        <jackson.version>3.1.2</jackson.version>
        <spring.version>7.0.7</spring.version>
        <servlet.version>6.1.0</servlet.version>
        <junit.version>6.0.3</junit.version>
    </properties>

    <dependencies>
        <!-- the only runtime dependency (registration uses java.net.http) -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- optional Spring MVC adapter (ro.kf.sdk.spring): provided by the Boot app when used -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${servlet.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- tests only: the same JUnit as Spring Boot 4.0.6 (the platform) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- sdk.properties carries ${project.version}: SdkVersion.SDK_VERSION is the artifact version -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
            </plugin>
            <!--
                The fake platform for the modules' tests: ro.kf.sdk.testing.FakePlatform, published ONLY in
                the "tests" artifact (ro.kf:kf-module-sdk:<version>:tests, type test-jar), which a module takes with
                scope test. The main artifact is unchanged: FakePlatform never reaches a module's runtime.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <id>fake-platform</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>ro/kf/sdk/testing/**</include>
                            </includes>
                            <excludes>
                                <exclude>ro/kf/sdk/testing/*Test.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
