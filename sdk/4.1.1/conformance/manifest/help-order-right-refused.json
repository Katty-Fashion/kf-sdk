{
  "id": "manifest/help-order-right-refused",
  "area": "manifest",
  "description": "An order outside 0-10000 is refused, and a right under api.v1.m. that is not the right of one of the module's own routes (a platform code is the platform's check at upload).",
  "source": "sdk-protocol.md §3.2, §7.13",
  "input": {
    "manifest": {
      "schemaVersion": 3,
      "slug": "kf-aas-r3",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "AAS",
          "page.utils-help": "AAS help",
          "help.aas-overview.summary": "What the AAS pages do and how they connect"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/kf-aas-r3/shells",
            "right": "api.v1.m.kf-aas-r3.shells.get"
          }
        ],
        "surfaces": [
          {
            "slug": "module.pages",
            "kind": "react",
            "page": "utils-help"
          },
          {
            "slug": "module.pages",
            "kind": "react",
            "page": "utils-shells"
          },
          {
            "slug": "module.pages",
            "kind": "react",
            "page": "mapping"
          },
          {
            "slug": "setup.sections",
            "kind": "react",
            "page": "platforms"
          }
        ],
        "help": [
          {
            "key": "aas-overview",
            "title": "page.utils-help",
            "page": "utils-help",
            "order": 10001,
            "right": "api.v1.m.kf-aas-r3.secret.get"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "kf-module-conf.json: capabilities.help[0].order must be an integer from 0 to 10000 (got 10001)",
      "kf-module-conf.json: capabilities.help[0].right \"api.v1.m.kf-aas-r3.secret.get\" is not the right of a route this module declares (capabilities.routes[].right of api.v1.m.kf-aas-r3.*)"
    ]
  }
}
