{
  "id": "manifest/help-unknown-field-refused",
  "area": "manifest",
  "description": "url and body are not keys of a help note: the closed object refuses them.",
  "source": "sdk-protocol.md §3.2, §7.13",
  "input": {
    "manifest": {
      "schemaVersion": 3,
      "slug": "kf-aas-r3",
      "name": "module.name",
      "version": "1.0.0",
      "platform": ">=4.1",
      "i18n": {
        "en": {
          "module.name": "AAS",
          "page.utils-help": "AAS help",
          "help.aas-overview.summary": "What the AAS pages do and how they connect"
        }
      },
      "capabilities": {
        "routes": [
          {
            "method": "GET",
            "path": "/m/kf-aas-r3/shells",
            "right": "api.v1.m.kf-aas-r3.shells.get"
          }
        ],
        "surfaces": [
          {
            "slug": "module.pages",
            "kind": "react",
            "page": "utils-help"
          },
          {
            "slug": "module.pages",
            "kind": "react",
            "page": "utils-shells"
          },
          {
            "slug": "module.pages",
            "kind": "react",
            "page": "mapping"
          },
          {
            "slug": "setup.sections",
            "kind": "react",
            "page": "platforms"
          }
        ],
        "help": [
          {
            "key": "aas-overview",
            "title": "page.utils-help",
            "page": "utils-help",
            "url": "https://wiki.example/aas",
            "body": "help.body"
          }
        ]
      }
    }
  },
  "expect": {
    "valid": false,
    "errorsContain": [
      "kf-module-conf.json: capabilities.help[0]: \"url\" is not a key of a help note (known: key, title, summary, page, section, context, right, order)",
      "kf-module-conf.json: capabilities.help[0]: \"body\" is not a key of a help note"
    ]
  }
}
